PING_INTERVAL_SECONDS=300
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=3000
LOG_FILE_PATH=/var/log/pinger.log
# DB_USER и DB_PASSWORD намеренно убраны — получаются из HashiCorp Vault
# VAULT_ADDR и VAULT_SECRET_PATH задаются в docker-compose.yml (environment)
